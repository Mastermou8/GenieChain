--- !u!114 &864689598
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 864689595}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a3ae53b6d61cb248b10a369773eeb64, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogManager: {fileID: 358995790}
  playerController: {fileID: 865685251}
  wishCarrier: {fileID: 0}
  message: 'Hellooooo | Im roxy '
  WorldPeace: '  Isn''t it a wonderful day to be alive? | Now we can all enjoy life
    and have some tea'
  Money: '  Hey! | Nice suit, did you get a promotion?'
  Relationships: "  Hello Handsome | Don\u2019t forget about our picnic date later
    tonight<3"
  Accomplished: '  That''s a nice-looking medal right there!'
  MoreWishes: ...
  Immortality: '  You look just like you looked yesterday!'
  Nothing: ...
  WorldPeace_Money: '  A pleasure to see you, Sr. | Hope I''m not in your way | just
    picking up some flowers'
  WorldPeace_Relationships: '  Look at you, dear. You finally did it!!'
  WorldPeace_Accomplished: '  Hello Mr... | I saw you the other day on the news |
    Its great to have someone as good as you'
  WorldPeace_MoreWishes: Isn't it a wonderful day to be alive? | Now we can all enjoy
    life and have some tea
  WorldPeace_Immortality: "To love someone and outlast them\u2026 | Hold them close.
    Every single day."
  Money_Relationships: You missed our tea date | have you been busy? :(
  Money_Accomplished: 'I see you changed.. | just dont let the gold drown the person
    i used know '
  Money_MoreWishes: Never seen someone that successful | I wonder what you got hidden
  Money_Immortality: The flowers i got are dying | I guess it's just part of the
    beauty of life
  Relationships_Accomplished: 'You are doing a great work | Il be here cheering you
    on my love '
  Relationships_MoreWishes: 
  Relationships_Immortality: No matter what | ill always be by your side
  Accomplished_MoreWishes: 
  Accomplished_Immortality: That's a nice-looking medal right there!
  MoreWishes_Immortality: 
  WorldPeace_Money_Relationships: Look at you, dear. You finally did it!! | ...You
    do still know my name, right? | Haha... mostly joking!
  WorldPeace_Money_Accomplished: You look just like you looked yesterday! | Funny
    how some things never change! | Good funny, I mean
  WorldPeace_Money_MoreWishes: 
  WorldPeace_Money_Immortality: 
  WorldPeace_Relationships_Accomplished: 'You''re everybody''s favorite person lately!
    | Mine too! | Don''t let it go to your head! '
  WorldPeace_Relationships_MoreWishes: 
  WorldPeace_Relationships_Immortality: 
  WorldPeace_Accomplished_MoreWishes: 
  WorldPeace_Accomplished_Immortality: 
  WorldPeace_MoreWishes_Immortality: 
  Money_Relationships_Accomplished: Look at you, dear. You finally did it!! | ...You
    do still know my name, right? | Haha... mostly joking!
  Money_Relationships_MoreWishes: 
  Money_Relationships_Immortality: 
  Money_Accomplished_MoreWishes: 
  Money_Accomplished_Immortality: 
  Money_MoreWishes_Immortality: 
  Relationships_Accomplished_MoreWishes: 
  Relationships_Accomplished_Immortality: 
  Relationships_MoreWishes_Immortality: 
  Accomplished_MoreWishes_Immortality: 
  playerTag: Player
  InteractionPrompt: {fileID: 1826837801}
  npcName: Roxy
